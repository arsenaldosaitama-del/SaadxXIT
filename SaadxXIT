    -- ============================================
    local function createESPBoxForPlayer(player)
        if not player or player == LocalPlayer then return end
        if not drawingAvailable then return end
        if espBoxes[player] then return end

        local character = player.Character
        if not character then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return end

        local box = Drawing.new("Square")
        box.Color = Color3.fromRGB(255, 255, 255)
        box.Thickness = 2
        box.Filled = false
        box.Transparency = 1
        box.Visible = false
        box.ZIndex = 5

        espBoxes[player] = { box = box, connections = {} }
    end

    local function updateESPBoxPosition(player)
        local data = espBoxes[player]
        if not data or not data.box then return end

        local character = player.Character
        if not character then data.box.Visible = false return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local root = character:FindFirstChild("HumanoidRootPart")
        local head = character:FindFirstChild("Head")
        if not humanoid or humanoid.Health <= 0 or not root or not head then
            data.box.Visible = false
            return
        end

        local rootPos, rootOn = Camera:WorldToViewportPoint(root.Position)
        local headPos, headOn = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.35, 0))
        local feetPos, feetOn = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))

        if not rootOn or not headOn or not feetOn or rootPos.Z <= 0 or headPos.Z <= 0 or feetPos.Z <= 0 then
            data.box.Visible = false
            return
        end

        local height = math.abs(feetPos.Y - headPos.Y)
        local width = math.max(height * 0.55, 8)
        data.box.Size = Vector2.new(width, height)
        data.box.Position = Vector2.new(rootPos.X - width / 2, headPos.Y)
        data.box.Visible = true
    end

    local function removeESPBoxForPlayer(player)
        local data = espBoxes[player]
        if not data then return end
        if data.connections then
            for _, conn in ipairs(data.connections) do
                if conn then conn:Disconnect() end
            end
        end
        if data.box then data.box:Remove() end
        espBoxes[player] = nil
    end

    local function removeAllESPBox()
