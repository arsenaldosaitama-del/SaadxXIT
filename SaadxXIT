                if espActive and Settings.ESPHighlights then
                    local temHighlight = false
                    for _, highlight in ipairs(espHighlights) do
                        if highlight and highlight.Parent and highlight.Adornee == character then
                            temHighlight = true
                            break
                        end
                    end
                    
                    if not temHighlight then
                        local highlight = criarHighlightParaPersonagem(character)
                        if highlight then
                            table.insert(espHighlights, highlight)
                            print("ESP adicionado para: " .. player.Name .. " (após respawn/join)")
                        end
                    end
                end
            end)
            
            table.insert(espConnections, characterAddedConnection)
        end)
        
        table.insert(espConnections, playerAddedConnection)
        print("Sistema de rastreamento de jogadores configurado")
    end

    local function configurarLoopESP()
        if espUpdateConnection then
            espUpdateConnection:Disconnect()
            espUpdateConnection = nil
        end
        
        espUpdateConnection = RunService.Heartbeat:Connect(function(deltaTime)
            lastESPUpdate = lastESPUpdate + deltaTime
            if lastESPUpdate >= ESP_UPDATE_INTERVAL then
                lastESPUpdate = 0
                atualizarESP()
            end
        end)
        
        print("Loop de atualização do ESP configurado")
    end

    -- ============================================
    -- INICIALIZAR
    -- ============================================
    criarMenu()
    configurarRastreamentoJogadores()
    configurarLoopESP()

    RunService.RenderStepped:Connect(function()
        if Settings.FOVCircle then
            atualizarFOVCircle()
        else
            if fovDrawing then
                fovDrawing:Remove()
                fovDrawing = nil
            end
        end

        if Settings.Aimbot then
            aimbot()
        end
    end)

    UserInputService.WindowFocused:Connect(function()
        if Settings.FOVCircle and fovDrawing then
            local viewportSize = Camera.ViewportSize
            fovDrawing.Position = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
        end
    end)

    if Settings.FOVCircle then
        criarFOVCircle()
    end

    if Settings.ESPHighlights then
        ativarESP()
    end

    print("========================================")
    print("✅ Saadx XIT | discord.gg/wMZCmpyJd3")
    print("✅ Fluxo PvP Aimbot carregado com sucesso!")
    print("✅ COMPATÍVEL COM MOBILE!")
    print("✅ TODAS AS FUNÇÕES ATIVAS!")
    print("========================================")
end

