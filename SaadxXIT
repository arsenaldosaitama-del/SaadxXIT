        local character = player.Character
        if not character then return end
        
        local humanoid = character:FindFirstChild("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return end
        
        local line = Drawing.new("Line")
        line.Color = Color3.fromRGB(255, 0, 0)
        line.Thickness = 2
        line.Transparency = 0.3
        line.Visible = false
        line.ZIndex = 5
        
        espLines[player] = {
            line = line,
            connections = {},
            active = true,
        }
    end
    
    local function updateESPLinePosition(player)
        if not player or player == LocalPlayer then return end
        
        local data = espLines[player]
        if not data or not data.line then return end
        
        local character = player.Character
        if not character then
            data.line.Visible = false
            return
        end
        
        local humanoid = character:FindFirstChild("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            data.line.Visible = false
            return
        end
        
        local part = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
        if not part then
            data.line.Visible = false
            return
        end
        
        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
        
        if not onScreen or screenPos.Z <= 0 then
            data.line.Visible = false
            return
        end
        
        local viewport = Camera.ViewportSize
        local bottomCenter = Vector2.new(viewport.X / 2, viewport.Y)
        
        data.line.From = bottomCenter
        data.line.To = Vector2.new(screenPos.X, screenPos.Y)
        data.line.Visible = true
    end
    
    local function removeESPLineForPlayer(player)
        local data = espLines[player]
        if not data then return end
        
        if data.connections then
            for _, conn in ipairs(data.connections) do
                if conn then conn:Disconnect() end
            end
            data.connections = {}
        end
        
        if data.line then
            data.line:Remove()
        end
        
        espLines[player] = nil
    end
    
    local function removeAllESPLine()
        for player, data in pairs(espLines) do
            if data and data.line then
                data.line:Remove()
            end
            espLines[player] = nil
        end
        espLines = {}
