    -- ============================================
    -- AIMBOT COM WALLCHECK CORRIGIDO (VERSÃO FINAL)
    -- ============================================
    local function getClosestPlayer()
        local closest, shortest = nil, Settings.FOVRadius
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local camPos = Camera.CFrame.Position
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LocalPlayer then continue end
            if not p.Character then continue end
            
            local humanoid = p.Character:FindFirstChild("Humanoid")
            if not humanoid or humanoid.Health <= 0 then continue end
            
            local part = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
            if not part then continue end
            
            local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if not onScreen then continue end
            
            local distance = (Vector2.new(pos.X, pos.Y) - center).Magnitude
            if distance >= shortest then continue end
            
            -- 🔥 WALLCHECK CORRIGIDO
            if Settings.WallCheck then
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Blacklist
                -- 🔥 Ignora APENAS o personagem local (não o inimigo)
                params.FilterDescendantsInstances = {LocalPlayer.Character}
                params.IgnoreWater = true
                
                -- 🔥 Usa a distância REAL até o alvo (não fixa)
                local direction = part.Position - camPos
                local raycastResult = workspace:Raycast(camPos, direction, params)
                
                -- 🔥 Se não acertou nada → mira liberada
                if not raycastResult then
                    closest, shortest = p, distance
                -- 🔥 Se acertou o inimigo → mira liberada
                elseif raycastResult.Instance:IsDescendantOf(p.Character) then
                    closest, shortest = p, distance
                end
                -- 🔥 Se acertou outra coisa (parede, chão) → BLOQUEIA
            else
                closest, shortest = p, distance
            end
        end
        
        return closest
    end

    local function aimbot()
        if not Settings.Aimbot then return end
        local target = getClosestPlayer()
        if target then
            local part = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
            if part then
                local dir = (part.Position - Camera.CFrame.Position).Unit
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, Camera.CFrame.Position + dir), Settings.Smoothness)
            end
        end
    end

    -- ============================================
    -- ESP
    -- ============================================
    local function criarHighlight(personagem)
        if not personagem or not personagem.Parent then return nil end
        for _, h in ipairs(espHighlights) do
            if h and h.Parent and h.Adornee == personagem then return h end
        end
        local h = Instance.new("Highlight")
        h.Adornee, h.FillColor, h.FillTransparency, h.OutlineColor, h.OutlineTransparency, h.DepthMode = personagem, Color3.fromRGB(255,0,0), 0.3, Color3.fromRGB(255,255,255), 0, Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = personagem
        return h
    end

    local function adicionarESP()
        if not espActive then return 0 end
        local c = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local h = criarHighlight(p.Character)
                if h then
                    local existe = false
                    for _, eh in ipairs(espHighlights) do if eh == h then existe = true break end end
                    if not existe then table.insert(espHighlights, h) c = c + 1 end
                end
            end
        end
        return c
    end

    local function limparESP()
        for i = #espHighlights, 1, -1 do
            if espHighlights[i] then
                if espHighlights[i].Parent then espHighlights[i]:Destroy() end
                espHighlights[i] = nil
            end
        end
        espHighlights = {}
    end

    function ativarESP()
        if espActive then return end
        Settings.ESPHighlights = true
        espActive = true
        limparESP()
        adicionarESP()
    end

    function desativarESP()
        if not espActive then return end
        Settings.ESPHighlights = false
        espActive = false
        limparESP()
    end

    local function atualizarESP()
        if not espActive or not Settings.ESPHighlights then return end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local tem = false
                for _, h in ipairs(espHighlights) do
                    if h and h.Parent and h.Adornee == p.Character then tem = true break end
                end
                if not tem then
                    local h = criarHighlight(p.Character)
                    if h then table.insert(espHighlights, h) end
                end
            end
        end
        for i = #espHighlights, 1, -1 do
            local h = espHighlights[i]
            if h then
                local a = h.Adornee
                if not (a and a.Parent and a:IsDescendantOf(workspace)) then
                    if h.Parent then h:Destroy() end
                    table.remove(espHighlights, i)
                end
            else
                table.remove(espHighlights, i)
            end
        end
    end

    -- ============================================
    -- EVENTOS
    -- ============================================
    local function configurarEventos()
        for _, c in ipairs(espConnections) do if c then c:Disconnect() end end
        espConnections = {}
        local pc = Players.PlayerAdded:Connect(function(p)
            local cc = p.CharacterAdded:Connect(function(c)
                task.wait(0.5)
                if espActive and Settings.ESPHighlights then
                    local tem = false
                    for _, h in ipairs(espHighlights) do
                        if h and h.Parent and h.Adornee == c then tem = true break end
                    end
                    if not tem then
                        local h = criarHighlight(c)
                        if h then table.insert(espHighlights, h) end
                    end
                end
            end)
            table.insert(espConnections, cc)
        end)
        table.insert(espConnections, pc)
    end

    local function configurarLoop()
        if espUpdateConnection then espUpdateConnection:Disconnect() end
        espUpdateConnection = RunService.Heartbeat:Connect(function(dt)
            lastESPUpdate = lastESPUpdate + dt
            if lastESPUpdate >= 1.5 then
                lastESPUpdate = 0
                atualizarESP()
            end
        end)
    end

    -- ============================================
    -- INICIALIZAR
    -- ============================================
    criarMenu()
    configurarEventos()
    configurarLoop()

    RunService.RenderStepped:Connect(function()
        if Settings.FOVCircle then atualizarFOV() else if fovDrawing then fovDrawing:Remove() fovDrawing = nil end end
        if Settings.Aimbot then aimbot() end
    end)

    UserInputService.WindowFocused:Connect(function()
        if Settings.FOVCircle and not mobile and fovDrawing then
