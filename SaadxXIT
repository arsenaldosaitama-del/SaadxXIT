    local function isTargetValid(player)
        if not player then return false end
        if player == LocalPlayer then return false end
        if not player.Character then return false end
        
        local humanoid = player.Character:FindFirstChild("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return false end
        
        local part = player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")
        if not part then return false end
        
        local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then return false end
        
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local distance = (Vector2.new(pos.X, pos.Y) - center).Magnitude
        
        if distance > Settings.FOVRadius then return false end
        
        if Settings.WallCheck then
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Blacklist
            params.FilterDescendantsInstances = {LocalPlayer.Character}
            params.IgnoreWater = true
            
            local camPos = Camera.CFrame.Position
            local direction = part.Position - camPos
            local raycastResult = workspace:Raycast(camPos, direction, params)
            
            if raycastResult and not raycastResult.Instance:IsDescendantOf(player.Character) then
                return false
            end
        end
        
        return true
    end

    local function getClosestPlayer()
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local camPos = Camera.CFrame.Position
        
        local bestPlayer = nil
        local bestDistance = Settings.FOVRadius
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LocalPlayer then continue end
            if not p.Character then continue end
            
            local humanoid = p.Character:FindFirstChild("Humanoid")
            if not humanoid or humanoid.Health <= 0 then continue end
            
            local part = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
            if not part then continue end
            
            local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if not onScreen then continue end
            
            local distance = (Vector2.new(pos.X, pos.Y) - center).Magnitude
            if distance >= bestDistance then continue end
            
            if Settings.WallCheck then
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Blacklist
                params.FilterDescendantsInstances = {LocalPlayer.Character}
                params.IgnoreWater = true
                
                local direction = part.Position - camPos
                local raycastResult = workspace:Raycast(camPos, direction, params)
                
                if raycastResult and not raycastResult.Instance:IsDescendantOf(p.Character) then
                    continue
                end
            end
            
            bestPlayer = p
            bestDistance = distance
        end
        
        return bestPlayer, bestDistance
    end

    local function aimbot(deltaTime)
        if not Settings.Aimbot then return end
        
        local target = nil
        
        if targetLocked and currentTarget then
            if isTargetValid(currentTarget) then
                target = currentTarget
            else
                targetLocked = false
                currentTarget = nil
            end
        end
        
        if not target then
            local newTarget, _ = getClosestPlayer()
            if newTarget then
                target = newTarget
                currentTarget = target
                targetLocked = true
            end
        end
        
        if not target then
            currentTarget = nil
            targetLocked = false
            return
        end
        
        local part = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
        if not part then
            targetLocked = false
            currentTarget = nil
            return
        end
        
        local targetPos = part.Position
        local currentPos = Camera.CFrame.Position
        local direction = (targetPos - currentPos).Unit
        
        local targetCFrame = CFrame.lookAt(currentPos, currentPos + direction)
        
        local smoothValue = math.clamp(Settings.Smoothness, 0.1, 1.0)
        local adjustedSmooth = 1 - (1 - smoothValue) ^ (deltaTime * 60)
        adjustedSmooth = math.clamp(adjustedSmooth, 0.01, 1.0)
        
        Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, adjustedSmooth)
    end

    -- ============================================
    -- ESP
    -- ============================================
    local function criarHighlight(personagem)
        if not personagem or not personagem.Parent then return nil end
        for _, h in ipairs(espHighlights) do
            if h and h.Parent and h.Adornee == personagem then return h end
        end
        local h = Instance.new("Highlight")
        h.Adornee, h.FillColor, h.FillTransparency, h.OutlineColor, h.OutlineTransparency, h.DepthMode = personagem, Color3.fromRGB(255,0,0), 0.3, Color3.fromRGB(255,255,255), 0, Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = personagem
        return h
    end

    local function adicionarESP()
        if not espActive then return 0 end
        local c = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local h = criarHighlight(p.Character)
                if h then
                    local existe = false
                    for _, eh in ipairs(espHighlights) do if eh == h then existe = true break end end
                    if not existe then table.insert(espHighlights, h) c = c + 1 end
                end
            end
        end
        return c
    end

    local function limparESP()
        for i = #espHighlights, 1, -1 do
            if espHighlights[i] then
                if espHighlights[i].Parent then espHighlights[i]:Destroy() end
                espHighlights[i] = nil
            end
        end
        espHighlights = {}
    end

    function ativarESP()
        if espActive then return end
        Settings.ESPHighlights = true
        espActive = true
        limparESP()
        adicionarESP()
    end

    function desativarESP()
        if not espActive then return end
        Settings.ESPHighlights = false
        espActive = false
        limparESP()
    end

    local function atualizarESP()
        if not espActive or not Settings.ESPHighlights then return end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local tem = false
                for _, h in ipairs(espHighlights) do
                    if h and h.Parent and h.Adornee == p.Character then tem = true break end
                end
                if not tem then
                    local h = criarHighlight(p.Character)
                    if h then table.insert(espHighlights, h) end
                end
            end
        end
        for i = #espHighlights, 1, -1 do
            local h = espHighlights[i]
            if h then
                local a = h.Adornee
                if not (a and a.Parent and a:IsDescendantOf(workspace)) then
                    if h.Parent then h:Destroy() end
                    table.remove(espHighlights, i)
                end
            else
                table.remove(espHighlights, i)
            end
        end
    end

    -- ============================================
    -- EVENTOS
    -- ============================================
    local function configurarEventos()
        for _, c in ipairs(espConnections) do if c then c:Disconnect() end end
        espConnections = {}
        
        local playerAddedConn = Players.PlayerAdded:Connect(function(p)
            setupPlayerLineEvents(p)
            
            local charAddedConn = p.CharacterAdded:Connect(function(c)
                task.wait(0.5)
                if espActive and Settings.ESPHighlights then
                    local tem = false
                    for _, h in ipairs(espHighlights) do
                        if h and h.Parent and h.Adornee == c then tem = true break end
                    end
                    if not tem then
                        local h = criarHighlight(c)
                        if h then table.insert(espHighlights, h) end
                    end
                end
            end)
            table.insert(espConnections, charAddedConn)
        end)
        table.insert(espConnections, playerAddedConn)
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                setupPlayerLineEvents(p)
            end
        end
    end

    local function configurarLoop()
        if espUpdateConnection then espUpdateConnection:Disconnect() end
        espUpdateConnection = RunService.Heartbeat:Connect(function(dt)
            lastESPUpdate = lastESPUpdate + dt
            if lastESPUpdate >= 1.5 then
                lastESPUpdate = 0
                atualizarESP()
            end
        end)
    end

    -- ============================================
    -- INICIALIZAR
    -- ============================================
    configurarEventos()
    configurarLoop()
    
    if Settings.ESPLine then
        createESPLineForAllPlayers()
    end

    RunService.RenderStepped:Connect(function(deltaTime)
        if Settings.FOVCircle then 
            atualizarFOV() 
        else 
            if fovDrawing then fovDrawing:Remove() fovDrawing = nil end
        end
        
        if Settings.ESPLine and drawingAvailable then
            updateAllESPLine()
        end
        
        if Settings.Aimbot then 
            aimbot(deltaTime)
        else
            if currentTarget or targetLocked then
                currentTarget = nil
                targetLocked = false
            end
        end
    end)

    UserInputService.WindowFocused:Connect(function()
        if Settings.FOVCircle and not mobile and fovDrawing then
            local vp = Camera.ViewportSize
            fovDrawing.Position = Vector2.new(vp.X/2, vp.Y/2)
        end
    end)

    if Settings.FOVCircle and not mobile then criarFOV() end
    if Settings.ESPHighlights then ativarESP() end

    print("✅ Saadx XIT carregado com Rayfield Clássico! (Mobile: " .. tostring(mobile) .. ")")
end

