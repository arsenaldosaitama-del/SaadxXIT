-- ============================================
-- SISTEMA DE VERIFICAÇÃO CORRIGIDO (100% FUNCIONAL)
-- ============================================
local function verificarKey(key)
    -- Verifica se a key existe
    local expira = KeysValidas[key]
    if not expira then
        return false, "❌ KEY INVÁLIDA!"
    end
    
    -- Converte a data de expiração para números
    local dia, mes, ano = expira:match("(%d+)/(%d+)/(%d+)")
    if not dia or not mes or not ano then
        return false, "❌ DATA INVÁLIDA! Contate o suporte."
    end
    
    dia = tonumber(dia)
    mes = tonumber(mes)
    ano = tonumber(ano)
    
    -- Pega a data atual do sistema
    local agora = os.date("*t")
    local anoAtual = agora.year
    local mesAtual = agora.month
    local diaAtual = agora.day
    
    -- CONVERTE TUDO PARA NÚMERO (FORMATO: AAAAMMDD)
    -- Exemplo: 03/08/2026 → 20260803
    local dataExpira = ano * 10000 + mes * 100 + dia
    local dataAtual = anoAtual * 10000 + mesAtual * 100 + diaAtual
    
    -- DEBUG (opcional - mostra as datas no console)
    print("🔍 DATA DE EXPIRAÇÃO: " .. expira .. " (" .. dataExpira .. ")")
    print("📅 DATA ATUAL: " .. diaAtual .. "/" .. mesAtual .. "/" .. anoAtual .. " (" .. dataAtual .. ")")
    
    -- COMPARA AS DATAS
    if dataAtual > dataExpira then
        return false, "❌ KEY EXPIRADA! (Expirou em " .. expira .. ")"
    end
    
    return true, "✅ KEY VÁLIDA! Bem-vindo ao Saadx XIT!"
end

