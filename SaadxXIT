    local function createESPSkeletonForPlayer(player)
        if not player or player == LocalPlayer then return end
        if not drawingAvailable then return end
        if espSkeletons[player] then return end

        local character = player.Character
        if not character then return end
        local rig = getSkeletonRig(character)
        if not rig then return end

        local lines = {}
        for _ = 1, #skeletonConnections[rig] do
            local line = Drawing.new("Line")
            line.Color = Color3.fromRGB(255, 255, 255)
            line.Thickness = 1.5
            line.Transparency = 1
            line.Visible = false
            line.ZIndex = 6
            table.insert(lines, line)
        end

        espSkeletons[player] = {
            lines = lines,
            rig = rig,
        }
    end

    local function updateESPSkeletonPosition(player)
        local data = espSkeletons[player]
        if not data or not data.lines then return end

        local character = player.Character
        if not character then
            for _, line in ipairs(data.lines) do line.Visible = false end
            return
        end

        local rig = getSkeletonRig(character)
        if rig ~= data.rig then
            for _, line in ipairs(data.lines) do line.Visible = false end
            return
        end

        for i, connection in ipairs(skeletonConnections[data.rig]) do
            local line = data.lines[i]
            local a = character:FindFirstChild(connection[1])
            local b = character:FindFirstChild(connection[2])

            if not a or not b then
                line.Visible = false
                continue
            end

            local aPos, aOnScreen = Camera:WorldToViewportPoint(a.Position)
            local bPos, bOnScreen = Camera:WorldToViewportPoint(b.Position)

            if not aOnScreen or not bOnScreen or aPos.Z <= 0 or bPos.Z <= 0 then
                line.Visible = false
                continue
            end

            line.From = Vector2.new(aPos.X, aPos.Y)
            line.To = Vector2.new(bPos.X, bPos.Y)
            line.Visible = true
        end
    end

    local function removeESPSkeletonForPlayer(player)
        local data = espSkeletons[player]
        if not data then return end
        if data.lines then
            for _, line in ipairs(data.lines) do
                if line then line:Remove() end
            end
        end
        espSkeletons[player] = nil
    end

    local function createESPSkeletonForAllPlayers()
        if not Settings.ESPSkeleton then
            for player in pairs(espSkeletons) do
                removeESPSkeletonForPlayer(player)
            end
            return
        end
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                createESPSkeletonForPlayer(player)
            end
        end
    end

    local function updateAllESPSkeleton()
        if not Settings.ESPSkeleton then return end
        for player in pairs(espSkeletons) do
            updateESPSkeletonPosition(player)
        end
    end

    local function setupPlayerLineEvents(player)
        if player == LocalPlayer then return end
        
        local data = espLines[player]
        if data and data.connections then
            for _, conn in ipairs(data.connections) do
                if conn then conn:Disconnect() end
            end
            data.connections = {}
        end
        
        local connections = {}
        
        local charAddedConn = player.CharacterAdded:Connect(function()
            task.wait(0.5)
            if Settings.ESPLine then
                createESPLineForPlayer(player)
            end
            if Settings.ESPSkeleton then
                createESPSkeletonForPlayer(player)
            end
            if Settings.ESPBox then
                createESPBoxForPlayer(player)
            end
        end)
        table.insert(connections, charAddedConn)
        
        local charRemovingConn = player.CharacterRemoving:Connect(function()
            removeESPLineForPlayer(player)
            removeESPBoxForPlayer(player)
            removeESPSkeletonForPlayer(player)
        end)
        table.insert(connections, charRemovingConn)
        
        local playerRemovingConn = player.AncestryChanged:Connect(function()
            if not player.Parent then
                removeESPLineForPlayer(player)
                removeESPBoxForPlayer(player)
                removeESPSkeletonForPlayer(player)
            end
        end)
        table.insert(connections, playerRemovingConn)
        
        if espLines[player] then
            espLines[player].connections = connections
        end
    end

