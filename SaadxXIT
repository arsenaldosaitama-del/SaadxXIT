    -- ============================================
    -- ESP HIGHLIGHTS
    -- ============================================
    local function criarHighlightParaPersonagem(character)
        if not character or not character.Parent then
            return nil
        end
        
        for _, highlight in ipairs(espHighlights) do
            if highlight and highlight.Parent and highlight.Adornee == character then
                return highlight
            end
        end
        
        local highlight = Instance.new("Highlight")
        highlight.Adornee = character
        highlight.FillColor = Color3.fromRGB(255, 0, 0)
        highlight.FillTransparency = 0.3
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = character
        
        return highlight
    end

    local function adicionarESPTodosJogadores()
        if not espActive then return 0 end
        
        local count = 0
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local highlight = criarHighlightParaPersonagem(player.Character)
                if highlight then
                    local jaExiste = false
                    for _, h in ipairs(espHighlights) do
                        if h == highlight then
                            jaExiste = true
                            break
                        end
                    end
                    if not jaExiste then
                        table.insert(espHighlights, highlight)
                        count = count + 1
                    end
                end
            end
        end
        return count
    end

    local function limparHighlights()
        for i = #espHighlights, 1, -1 do
            local highlight = espHighlights[i]
            if highlight then
                if highlight.Parent then
                    highlight:Destroy()
                end
                espHighlights[i] = nil
            end
        end
        espHighlights = {}
    end

    function ativarESP()
        if espActive then
            return
        end
        
        Settings.ESPHighlights = true
        espActive = true
        
        limparHighlights()
        local count = adicionarESPTodosJogadores()
        print("ESP ATIVADO! Highlights criados: " .. count)
    end

    function desativarESP()
        if not espActive then
            return
        end
        
        Settings.ESPHighlights = false
        espActive = false
        
        limparHighlights()
        print("ESP DESATIVADO!")
    end

    local function atualizarESP()
        if not espActive or not Settings.ESPHighlights then
            return
        end
        
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local character = player.Character
                
                local temHighlightValido = false
                for _, highlight in ipairs(espHighlights) do
                    if highlight and highlight.Parent and highlight.Adornee == character then
                        temHighlightValido = true
                        break
                    end
                end
                
                if not temHighlightValido then
                    local highlight = criarHighlightParaPersonagem(character)
                    if highlight then
                        table.insert(espHighlights, highlight)
                        print("ESP adicionado para: " .. player.Name)
                    end
                end
            end
        end
        
        for i = #espHighlights, 1, -1 do
            local highlight = espHighlights[i]
            if highlight then
                local adornee = highlight.Adornee
                local isValid = adornee and adornee.Parent and adornee:IsDescendantOf(workspace)
                if not isValid then
                    if highlight.Parent then
                        highlight:Destroy()
                    end
                    table.remove(espHighlights, i)
                end
            else
                table.remove(espHighlights, i)
            end
        end
    end

